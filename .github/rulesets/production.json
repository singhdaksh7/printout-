{
  "name": "production protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/production"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "Web (types, tests, build)"
          },
          {
            "context": "API (types, schema, migrations, tests)"
          },
          {
            "context": "End-to-end (isolated database and ports)"
          },
          {
            "context": "UI quality (axe, focus, overflow)"
          },
          {
            "context": "Security (secret scan, dependency audit)"
          }
        ]
      }
    }
  ]
}
