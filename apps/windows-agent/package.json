{
  "name": "@printout/windows-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Printout Buddy Windows Print Agent (pairs a shop computer and its printer with Printout Buddy)",
  "type": "module",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "start": "tsx src/entry.ts"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
