generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SHOP_OWNER
  PLATFORM_ADMIN
  /// Marketplace customer (schema-v2 phase 1). Signs in only with a verified Firebase identity; never has a shop, password or admin access.
  CUSTOMER
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
  /// Target statuses (architecture PDF p1, Shop). Additive: nothing in the application sets or reads them yet.
  PILOT
  PAST_DUE
  CANCELLED
}

enum OrderStatus {
  NEW
  ACCEPTED
  PRINTING
  PRINTED
  READY
  COLLECTED
  CANCELLED
  EXPIRED
  /// Shop declined a NEW order (schema-v2 D7). Set only while ORDER_REJECT_ENABLED; clients must tolerate it before the flag is turned on.
  REJECTED
}

enum PaymentMethod {
  CASH
  UPI
}

/// Customer-to-shop settlement state, independent of the order status. A UTR submission is only PENDING_VERIFICATION, never proof.
enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  REFUNDED
}

enum DocumentStatus {
  UPLOADING
  AVAILABLE
  PRINTED_RETENTION
  DELETED
  FAILED
}

enum ColourMode {
  bw
  colour
}

enum PrintSides {
  single
  duplex
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Shop {
  id                 String              @id @default(cuid())
  slug               String              @unique
  displayName        String
  address            String?
  /// Indian PIN code (6 digits). Collected by self-onboarding; NULL for shops created before it existed.
  pincode            String?
  status             ShopStatus          @default(ACTIVE)
  /// Reference to the shop's data key in a managed KMS (target). Unset until KMS is chosen.
  kmsKeyRef          String?
  acceptsOrders      Boolean             @default(true)
  /// Discovery profile (schema-v2 phase 2). All nullable/defaulted: existing shops and clients are unaffected.
  addressLine2       String?
  city               String?
  state              String?
  country            String              @default("IN")
  latitude           Float?
  longitude          Float?
  /// Admin discovery verification. Separate from `status` (suspension) and from any subscription: an unverified ACTIVE shop works
  /// for QR/guest ordering but is hidden from customer discovery. Existing ACTIVE shops were backfilled to true.
  /// Customer payment settings (schema-v2 phase 4). Cash is always available by default; UPI needs upiId.
  upiId              String?
  acceptedPaymentMethods PaymentMethod[] @default([CASH])
  isVerified         Boolean             @default(false)
  verifiedAt         DateTime?
  /// Admin user id that last verified the shop (plain id, no FK: the audit trail is AuditLog).
  verifiedBy         String?
  paperOptions       ShopPaperOption[]
  images             ShopImage[]
  orderCounter       Int                 @default(0)
  users              User[]
  settings           ShopSettings?
  pricingRules       PricingRule[]
  orders             Order[]
  documents          Document[]
  devices            ShopDevice[]
  devicePrinters     DevicePrinter[]
  devicePrintJobs    DevicePrintJob[]
  devicePairingCodes DevicePairingCode[]
  auditLogs          AuditLog[]
  subscription       Subscription?
  memberships        Membership[]
  printAgents        PrintAgent[]
  printers           Printer[]
  printJobs          PrintJob[]
  customerSessions   CustomerSession[]
  invoices           Invoice[]
  notifications      ShopNotification[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([isVerified, status])
  @@index([latitude, longitude])
}

model User {
  id              String                @id @default(cuid())
  shopId          String?
  shop            Shop?                 @relation(fields: [shopId], references: [id], onDelete: SetNull)
  /// Required for SHOP_OWNER and PLATFORM_ADMIN (database CHECK User_email_required_for_staff); optional for CUSTOMER. Identity is never resolved by email.
  email           String?               @unique
  displayName     String
  passwordHash    String
  role            Role
  /// Extra roles beyond the primary `role`. Authorization still keys on `role`; grants are additive facts (never ADMIN via any API).
  roleGrants      UserRoleGrant[]
  /// Orders placed by this customer and documents uploaded by this customer (schema-v2 phase 3).
  customerOrders  Order[]               @relation("CustomerOrders")
  uploadedDocuments Document[]          @relation("DocumentUploader")
  /// Customer profile (schema-v2). Null for accounts that never set them. Not used by owner or admin flows.
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  pincode         String?
  latitude        Float?
  longitude       Float?
  /// Account block switch for customers (owners are blocked through Shop.status). Existing rows default to true.
  isActive        Boolean               @default(true)
  sessions        Session[]
  memberships     Membership[]
  twoFactor       AdminTwoFactor?
  recoveryCodes   AdminRecoveryCode[]
  loginChallenges AdminLoginChallenge[]
  phoneIdentity   UserPhoneIdentity?
  googleIdentity  UserGoogleIdentity?
  fcmRegistrations FcmRegistration[]
  refreshTokens   RefreshToken[]
  /// False for accounts created by phone self-onboarding: passwordHash is a random unusable value and email/password sign-in is not offered.
  passwordSet     Boolean               @default(true)
  /// Set whenever a session is opened (any sign-in method).
  lastLoginAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}

/// One row per (user, role). Backfilled from User.role; written only by server code, never from a client body.
model UserRoleGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, role])
  @@index([role])
}

/// Verified Firebase phone identity linked to ONE shop-owner account (an optional extra sign-in method; the password always
/// remains). A verified phone number never grants access by itself: a row exists only after an authenticated, password-
/// reauthenticated link. No OTP, ID token or raw secret is ever stored here.
model UserPhoneIdentity {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firebaseUid  String    @unique
  /// E.164, e.g. +919876543210. Unique across ALL accounts: one phone can sign in to exactly one shop owner.
  phoneE164    String    @unique
  linkedAt     DateTime  @default(now())
  lastSignInAt DateTime?
  /// Firebase auth_time (the OTP verification instant) of the newest token accepted: a token with auth_time <= this is a replay.
  lastAuthTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Verified Firebase Google identity linked to ONE shop-owner account (an optional extra sign-in method). Resolution is ONLY by the
/// Firebase uid: an email or phone that merely matches an existing user never links or signs in anything. Linking is explicit and
/// re-authenticated. `email` is the Google-verified address at link/sign-in time (lowercased).
model UserGoogleIdentity {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firebaseUid  String    @unique
  email        String
  linkedAt     DateTime  @default(now())
  lastSignInAt DateTime?
  /// Firebase auth_time of the newest token accepted (replay protection, same rule as the phone identity).
  lastAuthTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Platform-admin TOTP second factor. One row per admin. `enabledAt` is NULL while an enrollment is pending (secret
/// generated, no valid code yet): a pending row never challenges a login. `secretEnc` is AES-256-GCM (see src/two-factor/crypto.ts).
model AdminTwoFactor {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEnc     String
  /// Fingerprint (not the value) of the key that sealed secretEnc; lets operators see which rows still use an old key.
  keyId         String
  enabledAt     DateTime?
  /// Highest TOTP time-step already accepted: a code for a step <= this is a replay and is refused.
  lastUsedStep  BigInt    @default(0)
  recoveryAckAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

/// Single-use recovery codes. Only an Argon2id hash is stored; the plaintext is shown once at generation.
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

/// Short-lived pending sign-in: the password was verified, the second factor was not. It is NOT a session: no route
/// accepts it as authentication. Only the SHA-256 of the cookie token is stored.
model AdminLoginChallenge {
  id           String    @id @default(cuid())
  tokenHash    String    @unique
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Fingerprint of the password hash at issue time; a password change makes the challenge unusable.
  credentialFp String
  attempts     Int       @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id            String    @id @default(cuid())
  tokenHash     String    @unique
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  invalidatedAt DateTime?
  /// Mobile only: the rotating refresh-token family this access session belongs to (NULL for web cookie sessions).
  familyId      String?
  /// Mobile only: installation id bound at sign-in (also the key of the device's FCM registration).
  deviceId      String?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model ShopSettings {
  id            String   @id @default(cuid())
  shopId        String   @unique
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  publicContact String?
  brandColor    String?
  /// IANA timezone in which operatingHours and specialClosures are interpreted.
  timezone      String   @default("Asia/Kolkata")
  /// Weekly schedule: {"mon":[{"start":"09:00","end":"18:00"}],...}. NULL = no schedule configured (availability unknown, ordering unrestricted).
  operatingHours Json?
  /// [{"date":"YYYY-MM-DD","reason":"Diwali"}] - the whole local calendar day is closed.
  specialClosures Json   @default("[]")
  /// {"reason":"..." | null,"startedAt":ISO,"until":ISO | null}. Active while until is null or in the future.
  temporaryClosure Json?
  /// Emergency reopen: until this instant the shop counts as open regardless of schedule or closures.
  reopenUntil   DateTime?
  afterHoursPolicy AfterHoursPolicy @default(ACCEPT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// ACCEPT = customers may still submit orders while the shop is closed (legacy behaviour). BLOCK = new submissions rejected (SHOP_CLOSED).
enum AfterHoursPolicy {
  ACCEPT
  BLOCK
}

/// Paper sizes and types a shop advertises to customers. kind = paperSize | paperType (database CHECK). Absence of paperType rows means plain paper only.
model ShopPaperOption {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind   String
  value  String

  @@unique([shopId, kind, value])
}

/// Shop photos in PRIVATE object storage: only the key is stored; bytes are served through an authenticated API route.
model ShopImage {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  imageKey    String   @unique
  contentType String
  sizeBytes   Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([shopId, sortOrder])
}

model PricingRule {
  id                 String     @id @default(cuid())
  shopId             String
  shop               Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  paperSize          String     @default("A4")
  colourMode         ColourMode
  sides              PrintSides
  pricePerSheetPaise Int
  active             Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([shopId, paperSize, colourMode, sides])
}

model Document {
  id                    String           @id @default(cuid())
  shopId                String
  shop                  Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  order                 Order?
  /// Target multi-document jobs: the PrintJob this document belongs to. Null for every existing Order-backed document.
  /// Authenticated customer who initiated the upload (null for guest QR uploads). An order may only consume its uploader's documents.
  uploaderUserId        String?
  uploader              User?            @relation("DocumentUploader", fields: [uploaderUserId], references: [id], onDelete: SetNull)
  printJobId            String?
  printJob              PrintJob?        @relation(fields: [printJobId], references: [id], onDelete: SetNull)
  receipt               DeletionReceipt?
  objectKey             String           @unique
  originalFilename      String
  detectedMimeType      String?
  byteSize              BigInt?
  pageCount             Int?
  checksum              String?
  status                DocumentStatus   @default(UPLOADING)
  uploadedAt            DateTime?
  expiresAt             DateTime?
  printedAt             DateTime?
  /// First successful shop Print action (server time). Starts the retention window; it does NOT prove physical printing.
  printInitiatedAt      DateTime?
  deleteAfter           DateTime?
  deletedAt             DateTime?
  deletionError         String?
  deletionAttempts      Int              @default(0)
  lastDeletionAttemptAt DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([shopId, status])
  @@index([status, deleteAfter])
  @@index([status, expiresAt])
  @@index([status, createdAt])
  @@index([printJobId])
  @@index([uploaderUserId, createdAt])
}

model Order {
  id                             String               @id @default(cuid())
  shopId                         String
  shop                           Shop                 @relation(fields: [shopId], references: [id], onDelete: Restrict)
  documentId                     String               @unique
  document                       Document             @relation(fields: [documentId], references: [id])
  orderNumber                    String
  /// Authenticated marketplace customer (null for guest QR orders). Never changes after creation.
  paymentMethod                  PaymentMethod?
  paymentStatus                  PaymentStatus        @default(UNPAID)
  /// Customer-submitted UPI transaction reference (an unverified claim). Unique per shop.
  upiTxnRef                      String?
  paymentEvents                  OrderPaymentEvent[]
  customerUserId                 String?
  customer                       User?                @relation("CustomerOrders", fields: [customerUserId], references: [id], onDelete: SetNull)
  /// Customer instructions (max 500 characters, DB CHECK). Not used for pricing.
  note                           String?
  clientRequestId                String?
  trackingToken                  String               @unique
  customerDisplayNameOrReference String?
  status                         OrderStatus          @default(NEW)
  totalPaise                     Int
  currency                       String               @default("INR")
  priceSnapshot                  Json
  printOptionsSnapshot           Json
  histories                      OrderStatusHistory[]
  printJob                       PrintJob?
  notifications                  ShopNotification[]
  createdAt                      DateTime             @default(now())
  updatedAt                      DateTime             @updatedAt

  @@unique([shopId, orderNumber])
  @@unique([shopId, clientRequestId])
  @@unique([shopId, upiTxnRef])
  @@index([shopId, status, createdAt])
  @@index([shopId, createdAt])
  @@index([customerUserId, createdAt])
}

/// Append-only payment evidence (database trigger forbids UPDATE/DELETE). Refunds are manual records by a platform admin; no money moves here.
model OrderPaymentEvent {
  id          String        @id @default(cuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  shopId      String
  /// UPI_SUBMITTED | UPI_VERIFIED | UPI_REJECTED | CASH_RECEIVED | REFUND_RECORDED (database CHECK)
  event       String
  fromStatus  PaymentStatus?
  toStatus    PaymentStatus
  upiTxnRef   String?
  amountPaise Int?
  reason      String?
  actorUserId String?
  /// CUSTOMER | SHOP_OWNER | PLATFORM_ADMIN (database CHECK)
  actorRole   String
  createdAt   DateTime      @default(now())

  @@index([orderId, createdAt])
  @@index([shopId, createdAt])
}

model OrderStatusHistory {
  id            String       @id @default(cuid())
  orderId       String
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  reason        String?
  actorUserId   String?
  actorDeviceId String?
  createdAt     DateTime     @default(now())

  @@index([orderId, createdAt])
}

model Plan {
  id            String         @id @default(cuid())
  name          String         @unique
  /// Stable machine key (e.g. basic, pro) and limits from the architecture PDF. All null until the owner approves values.
  key           String?        @unique
  maxAgents     Int?
  maxPrinters   Int?
  staffEnabled  Boolean?
  pricePaise    Int
  active        Boolean        @default(true)
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum DevicePlatform {
  ANDROID
  WINDOWS
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

/// A paired printing device (future Android app / Windows agent). Authenticates with a high-entropy bearer credential;
/// only its SHA-256 digest is stored. shopId is the ONLY tenant source for every device request.
model ShopDevice {
  id                           String           @id @default(cuid())
  shopId                       String
  shop                         Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name                         String
  platform                     DevicePlatform
  status                       DeviceStatus     @default(ACTIVE)
  /// sha256 hex of the raw credential (credential is 256-bit random, so a fast digest is appropriate). Never the raw value.
  credentialHash               String           @unique
  /// Bumped on credential rotation (future). Rotation = new hash + version+1.
  credentialVersion            Int              @default(1)
  appVersion                   String?
  osVersion                    String?
  /// FCM registration token (ANDROID). Never returned by any API, never logged.
  pushToken                    String?
  pushTokenUpdatedAt           DateTime?
  lastSeenAt                   DateTime?
  revokedAt                    DateTime?
  revokedByUserId              String?
  /// Rotation: the superseded credential stays valid until previousCredentialValidUntil (lost-response safety), then is dead.
  previousCredentialHash       String?
  previousCredentialValidUntil DateTime?
  credentialRotatedAt          DateTime?
  printers                     DevicePrinter[]
  printJobs                    DevicePrintJob[]
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt

  @@index([shopId, status])
  @@index([previousCredentialHash])
}

/// One-time, short-lived pairing code created by a shop owner. Only an HMAC of the code is stored.
model DevicePairingCode {
  id              String    @id @default(cuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  codeHash        String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  usedByDeviceId  String?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@index([shopId, expiresAt])
}

model Subscription {
  id                    String             @id @default(cuid())
  shopId                String             @unique
  shop                  Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  planId                String
  plan                  Plan               @relation(fields: [planId], references: [id])
  status                SubscriptionStatus @default(ACTIVE)
  renewsAt              DateTime?
  /// Payment-gateway subscription id (unique when set). Payment processing is not enabled.
  gatewaySubscriptionId String?            @unique
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  shopId        String?
  shop          Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  actorUserId   String?
  /// SHOP_OWNER | SHOP_DEVICE | PLATFORM_ADMIN | SYSTEM (null on rows written before devices existed)
  actorType     String?
  actorDeviceId String?
  action        String
  targetType    String?
  targetId      String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([shopId, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------------------------------------------
// Target-architecture entities (PrintoutBuddy Architecture.pdf p1 Data model, p6 ER). ADDITIVE ONLY: nothing in the
// application reads or writes these yet, `Order` stays authoritative, and no status mapping is invented.
// Open decisions are listed in docs/SCHEMA_ALIGNMENT.md.
// ---------------------------------------------------------------------------------------------------------------

enum MembershipRole {
  OWNER
  STAFF
}

/// shop_id + user_id + role. Staff only on Pro and no billing access are application rules (not enforced here).
model Membership {
  id        String         @id @default(cuid())
  shopId    String
  shop      Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MembershipRole
  createdAt DateTime       @default(now())

  @@unique([shopId, userId])
  @@index([userId])
}

/// Windows print agent (target). Distinct from ShopDevice (the Android device foundation).
model PrintAgent {
  id             String    @id @default(cuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name           String
  credentialHash String    @unique
  agentVersion   String?
  lastSeenAt     DateTime?
  revokedAt      DateTime?
  printers       Printer[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([shopId])
}

/// Basic: 1 printer, Pro: up to 3. The limit check belongs to the insert path and is not a column constraint.
model Printer {
  id        String     @id @default(cuid())
  shopId    String
  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  agentId   String
  agent     PrintAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name      String
  colour    Boolean    @default(false)
  duplex    Boolean    @default(false)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([shopId])
  @@index([agentId])
}

enum PrintJobStatus {
  UPLOADING
  QUEUED
  PRINTING
  PRINTED
  FAILED
  CANCELLED
  EXPIRED
}

/// Target job (PDF p12 lifecycle). `orderId` links a job to an existing Order once a mapping is approved; no rows are
/// created from Orders today. Lease fields are set only by the future atomic claim.
model PrintJob {
  id             String         @id @default(cuid())
  shopId         String
  shop           Shop           @relation(fields: [shopId], references: [id], onDelete: Restrict)
  orderId        String?        @unique
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  code           String
  serviceDay     DateTime       @db.Date
  status         PrintJobStatus @default(UPLOADING)
  attempt        Int            @default(0)
  leaseId        String?
  leaseAgentId   String?
  leaseExpiresAt DateTime?
  expiresAt      DateTime?
  documents      Document[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([shopId, serviceDay, code])
  @@index([shopId, status])
  @@index([status, expiresAt])
}

/// One per document; accepted once by receiptId. `wipeFlags` is JSON because the PDF names "three wipe flags" without
/// naming them (unresolved). verifiedAt is set when sha256 matches the document.
model DeletionReceipt {
  id              String    @id @default(cuid())
  receiptId       String    @unique
  documentId      String    @unique
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Restrict)
  sha256          String
  wipeFlags       Json
  agentReportedAt DateTime?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
}

/// Anonymous customer session: no phone number, expires after 2 hours, only a truncated IP prefix is kept.
model CustomerSession {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ipPrefix  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([shopId, expiresAt])
}

/// Billing records (target). Gateway ids are unique so webhook replays are harmless. Statuses are free text until the
/// payment provider is chosen (unresolved). No payment processing is enabled.
model Invoice {
  id               String    @id @default(cuid())
  shopId           String
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Restrict)
  gatewayInvoiceId String?   @unique
  amountPaise      Int
  currency         String    @default("INR")
  status           String
  issuedAt         DateTime?
  paidAt           DateTime?
  payments         Payment[]
  createdAt        DateTime  @default(now())

  @@index([shopId, createdAt])
}

model Payment {
  id               String   @id @default(cuid())
  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  gatewayPaymentId String?  @unique
  gatewayEventId   String?  @unique
  amountPaise      Int
  status           String
  createdAt        DateTime @default(now())

  @@index([invoiceId])
}

/// Durable in-app notification for a shop (transactional outbox + inbox). Written in the SAME transaction as the event it
/// describes, so a committed order always has its notification. `seq` is the replay cursor; `dedupeKey` makes the write
/// idempotent. Payload holds only safe metadata (order id and number): never URLs, storage keys or file names.
model ShopNotification {
  id        String    @id @default(cuid())
  seq       BigInt    @unique @default(autoincrement())
  shopId    String
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type      String
  orderId   String?
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dedupeKey String
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([shopId, dedupeKey])
  @@index([shopId, seq])
  @@index([shopId, readAt])
  @@index([createdAt])
}

enum PrinterConnectivity {
  ONLINE
  OFFLINE
  ERROR
  UNKNOWN
}

/// A printer reported by a Windows print agent. `authorized` / `isDefault` are decisions of the shop owner, never of the agent.
/// The agent may only print to an authorized, present printer of its own device. One default per shop.
model DevicePrinter {
  id             String              @id @default(cuid())
  shopId         String
  shop           Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  deviceId       String
  device         ShopDevice          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name           String
  driverName     String?
  connectivity   PrinterConnectivity @default(UNKNOWN)
  statusDetail   String?
  supportsColour Boolean             @default(false)
  supportsDuplex Boolean             @default(false)
  paperSizes     Json?
  /// false when the last report no longer listed it (uninstalled).
  present        Boolean             @default(true)
  authorized     Boolean             @default(false)
  isDefault      Boolean             @default(false)
  lastReportedAt DateTime            @default(now())
  jobs           DevicePrintJob[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([deviceId, name])
  @@index([shopId, isDefault])
}

/// Print dispatch lifecycle. There is deliberately NO "printed" state: neither the spooler nor this platform has a hardware
/// acknowledgement. PRINT_INITIATED means "the spooler accepted the job and began processing it".
enum DevicePrintJobStatus {
  QUEUED
  CLAIMED
  DOWNLOADING
  SUBMITTING
  SUBMITTED_TO_SPOOLER
  PRINT_INITIATED
  FAILED
  CANCEL_REQUESTED
  CANCELED
  NEEDS_RECONCILIATION
}

/// One dispatch of an order to one authorized printer of one Windows device. deviceId/printerId are fixed at enqueue, so no
/// other device or shop can claim it. Lease fields are written only by the atomic claim and by the lease holder's progress calls.
model DevicePrintJob {
  id                 String                @id @default(cuid())
  shopId             String
  shop               Shop                  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId            String
  documentId         String
  deviceId           String
  device             ShopDevice            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  printerId          String
  printer            DevicePrinter         @relation(fields: [printerId], references: [id], onDelete: Cascade)
  status             DevicePrintJobStatus  @default(QUEUED)
  /// Status before CANCEL_REQUESTED (decides which agent reports are still legal).
  statusBeforeCancel DevicePrintJobStatus?
  attempt            Int                   @default(0)
  leaseId            String?
  leaseExpiresAt     DateTime?
  clientRequestId    String
  /// Snapshot of the order's print options at enqueue time: { copies, colourMode, sides, paperSize, pageSelection }.
  options            Json
  /// Set when the agent declared intent to hand the job to the spooler. Non-null => a retry may duplicate pages.
  submittingAt       DateTime?
  spoolerJobId       Int?
  spoolerState       String?
  printInitiatedAt   DateTime?
  errorCode          String?
  errorMessage       String?
  requestedByUserId  String?
  cancelRequestedAt  DateTime?
  resolvedByUserId   String?
  resolution         String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([shopId, clientRequestId])
  @@index([shopId, orderId])
  @@index([deviceId, status])
  @@index([shopId, status, createdAt])
}

/// Mobile app refresh credential (rotating, one live token per family). Only the SHA-256 hash is stored. Distinct from the Firebase
/// refresh token (never seen by the API) and from the access Session token it mints.
model RefreshToken {
  id            String    @id @default(cuid())
  familyId      String
  /// NULL for kind 'onboarding' (a verified phone that has no account yet).
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'user' = normal account family; 'onboarding' = restricted identity (subjectUid/subjectPhone), upgraded to a user family once the identity is linked.
  kind          String    @default("user")
  /// phone | google (restricted families only)
  subjectProvider String?
  subjectUid    String?
  subjectPhone  String?
  subjectEmail  String?
  tokenHash     String    @unique
  /// The access Session issued together with this token (ended when the token is rotated or revoked).
  sessionId     String?
  /// Installation id bound at exchange; a refresh from another device id is refused.
  deviceId      String
  clientType    String
  expiresAt     DateTime
  /// Set when the token was exchanged for a successor. Presenting it again later = reuse = the family is revoked.
  rotatedAt     DateTime?
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime?

  @@index([familyId])
  @@index([userId])
  @@index([subjectUid])
  @@index([expiresAt])
}

/// Push registration of one app installation of one user. SENSITIVE: the FCM token is stored only AES-256-GCM encrypted
/// (tokenCipher) plus a SHA-256 lookup hash; it is never returned by any API and never logged or audited.
model FcmRegistration {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tenant of the owner at registration time (from the session, never from the client).
  shopId           String?
  installationId   String
  /// android | ios | web
  platform         String
  tokenCipher      String
  tokenHash        String    @unique
  enabled          Boolean   @default(true)
  revokedAt        DateTime?
  lastRegisteredAt DateTime  @default(now())
  lastSuccessAt    DateTime?
  failureCount     Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, installationId])
  @@index([shopId])
}

/// Restricted, short-lived proof that a Firebase phone number was verified but is linked to NO shop account yet. It only
/// authorises POST /shops/onboarding and GET /users/me; it is not a session and is consumed by a successful onboarding.
model PhoneOnboardingGrant {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  /// phone | google: which verified identity this restricted principal represents.
  provider    String   @default("phone")
  firebaseUid String
  /// Set for provider phone, NULL for google.
  phoneE164   String?
  /// Google-verified email (provider google only); the account email at onboarding comes from here, never from the client.
  email       String?
  /// Firebase auth_time of the verified OTP / Google sign-in.
  authTime    DateTime
  expiresAt   DateTime
  /// Mobile only: the onboarding refresh family this grant (used as the restricted access token) belongs to, and its bound installation.
  familyId    String?
  deviceId    String?
  createdAt   DateTime @default(now())

  @@index([familyId])
  @@index([firebaseUid])
  @@index([expiresAt])
}
