generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
 SHOP_OWNER
 PLATFORM_ADMIN
}
enum ShopStatus {
 ACTIVE
 SUSPENDED
}
enum OrderStatus {
 NEW
 ACCEPTED
 PRINTING
 PRINTED
 READY
 COLLECTED
 CANCELLED
 EXPIRED
}
enum DocumentStatus {
 UPLOADING
 AVAILABLE
 PRINTED_RETENTION
 DELETED
 FAILED
}
enum ColourMode {
 bw
 colour
}
enum PrintSides {
 single
 duplex
}
enum SubscriptionStatus {
 ACTIVE
 SUSPENDED
 CANCELLED
}

model Shop {
  id String @id @default(cuid())
  slug String @unique
  displayName String
  address String?
  status ShopStatus @default(ACTIVE)
  acceptsOrders Boolean @default(true)
  orderCounter Int @default(0)
  users User[]
  settings ShopSettings?
  pricingRules PricingRule[]
  orders Order[]
  documents Document[]
  devices ShopDevice[]
  devicePairingCodes DevicePairingCode[]
  auditLogs AuditLog[]
  subscription Subscription?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model User {
  id String @id @default(cuid())
  shopId String?
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  email String @unique
  displayName String
  passwordHash String
  role Role
  sessions Session[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  invalidatedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}
model ShopSettings {
  id String @id @default(cuid())
  shopId String @unique
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  publicContact String?
  brandColor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PricingRule {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  paperSize String @default("A4")
  colourMode ColourMode
  sides PrintSides
  pricePerSheetPaise Int
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shopId, paperSize, colourMode, sides])
}
model Document {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  order Order?
  objectKey String @unique
  originalFilename String
  detectedMimeType String?
  byteSize BigInt?
  pageCount Int?
  checksum String?
  status DocumentStatus @default(UPLOADING)
  uploadedAt DateTime?
  expiresAt DateTime?
  printedAt DateTime?
  /// First successful shop Print action (server time). Starts the retention window; it does NOT prove physical printing.
  printInitiatedAt DateTime?
  deleteAfter DateTime?
  deletedAt DateTime?
  deletionError String?
  deletionAttempts Int @default(0)
  lastDeletionAttemptAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shopId, status])
  @@index([status, deleteAfter])
  @@index([status, expiresAt])
  @@index([status, createdAt])
}
model Order {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  documentId String @unique
  document Document @relation(fields: [documentId], references: [id])
  orderNumber String
  clientRequestId String?
  trackingToken String @unique
  customerDisplayNameOrReference String?
  status OrderStatus @default(NEW)
  totalPaise Int
  currency String @default("INR")
  priceSnapshot Json
  printOptionsSnapshot Json
  histories OrderStatusHistory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([shopId, orderNumber])
  @@unique([shopId, clientRequestId])
  @@index([shopId, status, createdAt])
  @@index([shopId, createdAt])
}
model OrderStatusHistory {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus OrderStatus
  reason String?
  actorUserId String?
  actorDeviceId String?
  createdAt DateTime @default(now())
  @@index([orderId, createdAt])
}
model Plan {
 id String @id @default(cuid())
 name String @unique
 pricePaise Int
 active Boolean @default(true)
 subscriptions Subscription[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
enum DevicePlatform {
  ANDROID
  WINDOWS
}
enum DeviceStatus {
  ACTIVE
  REVOKED
}
/// A paired printing device (future Android app / Windows agent). Authenticates with a high-entropy bearer credential;
/// only its SHA-256 digest is stored. shopId is the ONLY tenant source for every device request.
model ShopDevice {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name String
  platform DevicePlatform
  status DeviceStatus @default(ACTIVE)
  /// sha256 hex of the raw credential (credential is 256-bit random, so a fast digest is appropriate). Never the raw value.
  credentialHash String @unique
  /// Bumped on credential rotation (future). Rotation = new hash + version+1.
  credentialVersion Int @default(1)
  appVersion String?
  osVersion String?
  /// FCM registration token (ANDROID). Never returned by any API, never logged.
  pushToken String?
  pushTokenUpdatedAt DateTime?
  lastSeenAt DateTime?
  revokedAt DateTime?
  revokedByUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([shopId, status])
}
/// One-time, short-lived pairing code created by a shop owner. Only an HMAC of the code is stored.
model DevicePairingCode {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  codeHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  usedByDeviceId String?
  createdByUserId String?
  createdAt DateTime @default(now())
  @@index([shopId, expiresAt])
}
model Subscription {
 id String @id @default(cuid())
 shopId String @unique
 shop Shop @relation(fields:[shopId], references:[id], onDelete:Cascade)
 planId String
 plan Plan @relation(fields:[planId], references:[id])
 status SubscriptionStatus @default(ACTIVE)
 renewsAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
model AuditLog {
 id String @id @default(cuid())
 shopId String?
 shop Shop? @relation(fields:[shopId], references:[id], onDelete:SetNull)
 actorUserId String?
 /// SHOP_OWNER | SHOP_DEVICE | PLATFORM_ADMIN | SYSTEM (null on rows written before devices existed)
 actorType String?
 actorDeviceId String?
 action String
 targetType String?
 targetId String?
 metadata Json?
 createdAt DateTime @default(now())
 @@index([shopId, createdAt])
 @@index([createdAt])
}
