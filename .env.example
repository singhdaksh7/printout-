# Printout API / worker environment (names match apps/api/src/config.ts exactly).
# Local development: copy to .env and run as-is (placeholders are fine outside production).
# PRODUCTION: NODE_ENV=production makes the API and the worker FAIL CLOSED at startup with a list of problems unless the
# "[prod]" variables below are set to real values. Never commit real values. deploy/env.production.example is the
# deployment-oriented variant of this file.
#
# Generate secrets:  openssl rand -base64 48   (every secret different, >= 32 chars, no "change-me"/"replace"/"example"/"password")

# ---- NODE_ENV ----
# development | test | production
NODE_ENV=development
API_PORT=3000

# ---- Domain / origins ----
# [prod] Browser origin of the web app. Must be https:// and not localhost in production. Used for CORS and QR links.
WEB_ORIGIN=http://localhost:5173
# Optional absolute base URL of the API as seen by browsers (e.g. https://api.example.com). https in production.
# PUBLIC_API_BASE=

# ---- Database ----
# [prod] Prisma/PostgreSQL URL. Production refuses the default dev password. Apply schema with: prisma migrate deploy
DATABASE_URL=postgresql://printout:change-me@localhost:55433/printout?schema=public

# ---- Session / auth ----
# [prod] >= 32 chars each, random, all different (SESSION_SECRET, CSRF_SECRET, QUOTE_SECRET, STORAGE_URL_SECRET).
SESSION_SECRET=replace-with-a-long-random-local-secret
SESSION_DAYS=7
COOKIE_SAMESITE=lax
# Login route limit (per IP per minute) and failed-login lockout.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_FAIL_MAX=5
LOGIN_FAIL_WINDOW_MINUTES=15

# ---- CSRF ----
# [prod] HMAC key for the per-session CSRF token. Must differ from SESSION_SECRET.
CSRF_SECRET=replace-with-another-long-random-local-secret

# ---- Quote signing ----
# [prod] HMAC key for signed quote tokens (in development it falls back to a key derived from SESSION_SECRET).
# QUOTE_SECRET=
QUOTE_TTL_SECONDS=600
JSON_BODY_LIMIT_BYTES=65536

# ---- Storage ----
# local | s3. Production uses s3 (a PRIVATE R2/S3/B2 bucket: no public ACL/policy; documents are only reachable through
# short-lived presigned URLs, max 300 s and never beyond deleteAfter/expiresAt).
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=.data/uploads
# [prod, only with STORAGE_DRIVER=local] HMAC key for signed local document/upload URLs.
# STORAGE_URL_SECRET=
# [prod] STORAGE_DRIVER=local in production is refused unless you acknowledge it (single node, volume not backed up).
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# ---- S3 / R2 (all required when STORAGE_DRIVER=s3; endpoint must be https in production) ----
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto, path style true is safe. Credentials come ONLY from here.
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=printout-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# ---- Retention (frozen product semantics; change only deliberately) ----
PRINT_RETENTION_MINUTES=30
UNPRINTED_RETENTION_HOURS=24

# ---- Upload limits ----
# App-level cap for the raw PUT body (authoritative). Hard ceiling 104857600 (100 MiB): larger values are refused at startup.
# The reverse proxy body cap MUST be >= UPLOAD_MAX_BYTES + 1 MiB (Caddy: request_body { max_size 51MiB } for the default).
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_PDF_PAGES=200

# ---- Rate limits (requests per minute; in-memory, per API process) ----
# Public (per IP):
PUBLIC_RATE_LIMIT_MAX=60
# Authenticated shop/admin surfaces (keyed by session, falling back to IP). Defaults shown; unlimited when NODE_ENV=test.
# RATE_LIMIT_SHOP_READ_MAX=600
# RATE_LIMIT_STATUS_MAX=120
# RATE_LIMIT_PRINT_CONFIRM_MAX=60
# RATE_LIMIT_DOCUMENT_ACCESS_MAX=60
# RATE_LIMIT_SHOP_MUTATION_MAX=60
# RATE_LIMIT_ADMIN_READ_MAX=600
# RATE_LIMIT_ADMIN_MUTATION_MAX=60
# SSE: connection attempts per minute per session, and concurrent streams per shop.
# RATE_LIMIT_SSE_CONNECT_MAX=30
# SSE_MAX_CONNECTIONS_PER_SHOP=10
# SSE heartbeat; production requires <= 25000 (below proxy idle timeouts).
SSE_HEARTBEAT_MS=25000

# ---- Proxy trust ----
# [prod] MUST be set explicitly (TRUST_PROXY or TRUST_PROXY_CIDRS). Unset/false = never trust X-Forwarded-For (local dev).
# Preferred behind Caddy on the docker network: trust only private/loopback hops (client IP = first untrusted hop from the right).
# TRUST_PROXY_CIDRS=loopback,linklocal,uniquelocal
# TRUST_PROXY=false

# ---- Logging ----
# Logs are structured (pino) and never include query strings, cookies, CSRF tokens, passwords or tracking tokens.
# (Level is fixed: silent in test, info otherwise.)

# ---- Admin bootstrap (prisma/bootstrap-admin.ts; NOT read by the API) ----
# Pass inline, do not store: ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='...' node dist/prisma/bootstrap-admin.js
# ADMIN_PASSWORD min 12 chars (omit it on a TTY to be prompted). ADMIN_RESET_PASSWORD=1 resets an existing admin. No default password.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Platform Admin
# ADMIN_RESET_PASSWORD=0

# ---- Retention worker (src/worker.ts; same config validation as the API) ----
DOCUMENT_CLEANUP_INTERVAL_MINUTES=1
DOCUMENT_CLEANUP_BATCH_SIZE=100
DOCUMENT_STALE_UPLOAD_MINUTES=60
# WORKER_RUN_ONCE=1

# ---- Seed (development only): password for demo accounts created by `pnpm --filter @printout/api db:seed` ----
# SEED_PASSWORD=change-this-development-password
