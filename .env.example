NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
API_PORT=3000
DATABASE_URL=postgresql://printout:change-me@localhost:55433/printout?schema=public
# Secrets: >= 32 chars, random, different from each other. Production refuses placeholder values.
SESSION_SECRET=replace-with-a-long-random-local-secret
CSRF_SECRET=replace-with-a-long-random-local-secret
# Optional: HMAC key for quote tokens (falls back to a key derived from SESSION_SECRET).
# QUOTE_SECRET=
# Optional: dedicated key for signed storage URLs / upload tokens.
# STORAGE_URL_SECRET=
QUOTE_TTL_SECONDS=600
# Optional absolute base URL of the API as seen by browsers (e.g. https://api.example.com).
# PUBLIC_API_BASE=
# Set true when running behind a reverse proxy (so client IPs for rate limits are correct).
TRUST_PROXY=false
# Preferred behind a reverse proxy: comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (client IP = first non-trusted hop from the right).
# TRUST_PROXY_CIDRS=127.0.0.1,172.16.0.0/12
JSON_BODY_LIMIT_BYTES=65536

# Sessions / abuse limits
SESSION_DAYS=7
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_MAX=10
LOGIN_FAIL_MAX=5
LOGIN_FAIL_WINDOW_MINUTES=15
PUBLIC_RATE_LIMIT_MAX=60
SSE_HEARTBEAT_MS=25000

# Uploads and retention
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_PDF_PAGES=200
PRINT_RETENTION_MINUTES=30
UNPRINTED_RETENTION_HOURS=24

# Cleanup worker
DOCUMENT_CLEANUP_INTERVAL_MINUTES=1
DOCUMENT_CLEANUP_BATCH_SIZE=100
DOCUMENT_STALE_UPLOAD_MINUTES=60

# Storage: local | s3 (the S3_* values are required only when STORAGE_DRIVER=s3)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=.data/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=printout-documents
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true

# Seed (development): password for the demo accounts created by `pnpm --filter @printout/api db:seed`
# SEED_PASSWORD=change-this-development-password
