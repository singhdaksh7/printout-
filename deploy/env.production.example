# Printout production environment. Copy to deploy/.env.production (chmod 600) and fill in.
# (Named env.production.example, not .env.*, because the repo .gitignore ignores .env.* files.)
# NEVER commit the real file (.env.* is git-ignored). Placeholders below are rejected by the API in production.
# Format: plain KEY=value lines, no quotes needed, no spaces around '=', no trailing comments on a value line.
# Keys mirror apps/api/src/config.ts exactly; the API refuses to start (listing every bad key, never values) if one is invalid.
#
# Generate secrets on the server:
#   openssl rand -base64 48      # SESSION_SECRET, CSRF_SECRET, QUOTE_SECRET, STORAGE_URL_SECRET (all different)
#   openssl rand -hex 24         # POSTGRES_PASSWORD (must be URL-safe: hex only)

# ---- Edge / compose (read by docker compose + Caddy) ----
DOMAIN=printout.example.com
ACME_EMAIL=ops@example.com
# Only change for local testing of the prod stack on alternate ports:
# HTTP_PORT=80
# HTTPS_PORT=443
# Caddy request body cap. MUST be >= UPLOAD_MAX_BYTES + 1048576 (deploy.sh refuses to deploy otherwise).
# Default 53477376 = 52428800 (50 MiB) + 1 MiB. Raise it together with UPLOAD_MAX_BYTES.
# MAX_REQUEST_BODY=53477376
# Image tags (default builds locally: printout-api:local / printout-web:local):
# PRINTOUT_API_IMAGE=ghcr.io/you/printout-api:1.0.0
# PRINTOUT_WEB_IMAGE=ghcr.io/you/printout-web:1.0.0

# ---- Database ----
# DATABASE_URL is assembled by docker-compose.prod.yml from this password.
POSTGRES_PASSWORD=REPLACE_WITH_HEX_FROM_OPENSSL

# ---- API core (apps/api/src/config.ts) ----
# NODE_ENV, TRUST_PROXY_CIDRS (loopback,linklocal,uniquelocal: only Caddy on the docker network may set X-Forwarded-For),
# API_PORT and DATABASE_URL are set by the compose file; do not set them here.
# Must be https:// and NOT localhost in production (the API refuses to start otherwise). Same value as https://<DOMAIN>.
WEB_ORIGIN=https://printout.example.com
# Leave unset: browser and API share one origin behind Caddy. Only set if the API is served from another host.
# PUBLIC_API_BASE=
# >= 32 chars, random, distinct from each other. Values containing replace/change-me/example/password are rejected.
SESSION_SECRET=REPLACE_base64_48
CSRF_SECRET=REPLACE_base64_48_different
QUOTE_SECRET=REPLACE_base64_48_different_again
STORAGE_URL_SECRET=REPLACE_base64_48_different_again_2
# STORAGE_URL_SECRET is required when STORAGE_DRIVER=local and recommended always (signs upload/download tokens).
QUOTE_TTL_SECONDS=600
JSON_BODY_LIMIT_BYTES=65536

# ---- Sessions / abuse limits (defaults shown; limits are per API process, in memory) ----
SESSION_DAYS=7
COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_MAX=10
LOGIN_FAIL_MAX=5
LOGIN_FAIL_WINDOW_MINUTES=15
PUBLIC_RATE_LIMIT_MAX=60
# Production refuses > 25000 (proxy idle timeouts).
SSE_HEARTBEAT_MS=25000

# Optional per-minute limits for the authenticated surface (unset = built-in defaults shown). Counters are per API process.
# RATE_LIMIT_SHOP_READ_MAX=600
# RATE_LIMIT_STATUS_MAX=120
# RATE_LIMIT_PRINT_CONFIRM_MAX=60
# RATE_LIMIT_DOCUMENT_ACCESS_MAX=60
# RATE_LIMIT_SHOP_MUTATION_MAX=60
# RATE_LIMIT_ADMIN_READ_MAX=600
# RATE_LIMIT_ADMIN_MUTATION_MAX=60
# RATE_LIMIT_SSE_CONNECT_MAX=30
# SSE_MAX_CONNECTIONS_PER_SHOP=10

# ---- Uploads and retention (frozen product semantics; change only deliberately) ----
# Hard ceiling 104857600 (100 MiB). Keep MAX_REQUEST_BODY >= this + 1048576.
UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_PDF_PAGES=200
PRINT_RETENTION_MINUTES=30
UNPRINTED_RETENTION_HOURS=24

# ---- Cleanup worker ----
DOCUMENT_CLEANUP_INTERVAL_MINUTES=1
DOCUMENT_CLEANUP_BATCH_SIZE=100
DOCUMENT_STALE_UPLOAD_MINUTES=60

# ---- Storage ----
# s3 = private Cloudflare R2 / S3 / B2 bucket (production). local = a Docker volume on the VPS:
# NOT for production at scale, never backed up, lost with the server. Production + local is refused unless
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true is also set (do not, unless you accept those limits).
STORAGE_DRIVER=s3
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
LOCAL_UPLOAD_DIR=/data/uploads
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com   region: auto   path style: true is safe for R2
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=printout-documents
S3_ACCESS_KEY_ID=REPLACE_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=REPLACE_R2_SECRET_ACCESS_KEY
S3_FORCE_PATH_STYLE=true

# First admin: do NOT put ADMIN_* here (it would end up in the api container env). Pass inline:
#   ADMIN_EMAIL=you@example.com ADMIN_PASSWORD='...' bash deploy/deploy.sh bootstrap-admin

# ---- Backups (deploy/backup-db.sh): DATABASE METADATA ONLY. Never document storage (R2/uploads volume). ----
BACKUP_DIR=/var/backups/printout
BACKUP_RETENTION_DAYS=14
# Optional encryption: `age` recipient public key (age-keygen) OR gpg recipient (not both). Missing tool/key = backup fails.
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_GPG_RECIPIENT=
# Optional off-server copy via rclone, e.g. "r2backup:printout-db-backups": a DIFFERENT private bucket, DB dumps only.
# BACKUP_RCLONE_REMOTE=
